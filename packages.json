{
  "repo": "Art-of-Game/useful-packages",
  "organizationId": "18968138129184",
  "organizationName": "Art Of Game",
  "replaceDependencies": {
    "com.google.external-dependency-manager": {
      "name": "com.unity.external-dependency-manager",
      "version": "latest"
    }
  },
  "packages": [
    {
      "name": "com.google.firebase.app",
      "latestFrom": "firebase/firebase-unity-sdk",
      "tarball": "https://dl.google.com/games/registry/unity/{name}/{name}-{version}.tgz"
    },
    {
      "name": "com.google.firebase.messaging",
      "latestFrom": "firebase/firebase-unity-sdk",
      "tarball": "https://dl.google.com/games/registry/unity/{name}/{name}-{version}.tgz"
    },
    {
      "name": "com.google.firebase.analytics",
      "latestFrom": "firebase/firebase-unity-sdk",
      "tarball": "https://dl.google.com/games/registry/unity/{name}/{name}-{version}.tgz"
    },
    {
      "name": "com.google.firebase.auth",
      "latestFrom": "firebase/firebase-unity-sdk",
      "tarball": "https://dl.google.com/games/registry/unity/{name}/{name}-{version}.tgz"
    },
    {
      "name": "com.google.firebase.crashlytics",
      "latestFrom": "firebase/firebase-unity-sdk",
      "tarball": "https://dl.google.com/games/registry/unity/{name}/{name}-{version}.tgz"
    },
    {
      "name": "com.google.firebase.firestore",
      "latestFrom": "firebase/firebase-unity-sdk",
      "tarball": "https://dl.google.com/games/registry/unity/{name}/{name}-{version}.tgz"
    },
    {
      "name": "com.google.firebase.remote-config",
      "latestFrom": "firebase/firebase-unity-sdk",
      "tarball": "https://dl.google.com/games/registry/unity/{name}/{name}-{version}.tgz"
    },
    {
      "name": "com.google.signin",
      "vendorName": "com.coolishbee.google-signin",
      "latestFrom": "coolishbee/google-signin-unity",
      "latestBy": "tag",
      "tarball": "https://codeload.github.com/coolishbee/google-signin-unity/tar.gz/refs/tags/v{version}",
      "folder": "google-signin-unity-{version}/Packages/com.coolishbee.google-signin",
      "description": "Google Sign-In for Unity. Android uses CredentialManager + AuthorizationClient, iOS uses GIDSignIn, and Editor/Standalone uses a loopback OAuth flow. Originally by Google, updated by coolishbee: https://github.com/coolishbee/google-signin-unity",
      "author": {
        "name": "Google, coolishbee",
        "url": "https://github.com/coolishbee/google-signin-unity"
      }
    },
    {
      "name": "com.google.play.games",
      "latestFrom": "playgameservices/play-games-plugin-for-unity",
      "tarball": "https://codeload.github.com/playgameservices/play-games-plugin-for-unity/tar.gz/refs/tags/v{version}",
      "folder": "play-games-plugin-for-unity-{version}/Assets/Public/GooglePlayGames/com.google.play.games",
      "licence": "https://raw.githubusercontent.com/playgameservices/play-games-plugin-for-unity/v{version}/LICENSE"
    },
    {
      "name": "com.google.play.review",
      "latestBy": "archive",
      "tarball": "https://dl.google.com/games/registry/unity/{name}/{name}-{version}.tgz"
    },
    {
      "name": "com.google.play.appupdate",
      "latestBy": "archive",
      "tarball": "https://dl.google.com/games/registry/unity/{name}/{name}-{version}.tgz"
    },
    {
      "name": "com.google.play.core",
      "latestBy": "archive",
      "tarball": "https://dl.google.com/games/registry/unity/{name}/{name}-{version}.tgz"
    },
    {
      "name": "com.google.play.common",
      "latestBy": "archive",
      "tarball": "https://dl.google.com/games/registry/unity/{name}/{name}-{version}.tgz",
      "addDependencies": {
        "com.unity.ugui": "1.0.0"
      }
    },
    {
      "name": "com.facebook.sdk",
      "latestFrom": "meta/facebook-sdk-for-unity",
      "tarball": "https://github.com/meta/facebook-sdk-for-unity/releases/download/sdk-version-{version}/facebook-unity-sdk-{version}.zip",
      "unitypackage": "facebook-unity-sdk-{version}/FacebookSDK/facebook-unity-sdk-{version}.unitypackage",
      "licence": "https://raw.githubusercontent.com/meta/facebook-sdk-for-unity/sdk-version-{version}/LICENSE.txt",
      "take": {
        "Assets/FacebookSDK/Plugins/": "Plugins/",
        "Assets/FacebookSDK/SDK/": "SDK/",
        "Assets/FacebookSDK/link.xml": "link.xml",
        "Assets/Editor/": "Editor/",
        "Assets/FacebookSDK/Examples/": "Samples~/Examples/",
        "Assets/IAPiOS/IAP/": "Samples~/Examples/IAP/",
        "Assets/Scripts/": "Samples~/Examples/IAP/Scripts/",
        "Assets/StreamingAssets/": "Samples~/Examples/StreamingAssets/"
      },
      "leaveOut": [
        "Assets/ExternalDependencyManager/"
      ],
      "metaLike": {
        "Plugins/Windows/XInputDotNetPure.dll": "Plugins/Windows/LibFBGManaged.dll",
        "Plugins/Windows/x64/XInputInterface.dll": "Plugins/Windows/x64/zlib1.dll",
        "Plugins/Windows/x86/XInputInterface.dll": "Plugins/Windows/x86/zlib1.dll"
      },
      "changes": [
        "- Made into a Unity package from Meta's `.unitypackage`. All of Meta's files are here. The only thing left out is Google's External Dependency Manager, which Meta bundles and Google has deprecated.",
        "- Meta's examples, the IAP sample they call and the StreamingAssets files they read are under **Samples** in the Package Manager window, so they only enter a project when you import them.",
        "- `package.json` is new and depends on `com.unity.external-dependency-manager`.",
        "- `Editor/Facebook.Unity.PostProcess.asmdef` is new, because Unity compiles no script in a package without one.",
        "- `Editor/FacebookLinkFile.cs` is new, because Unity reads no `link.xml` from inside a package.",
        "- The `.meta` files of `XInputDotNetPure.dll` and the two `XInputInterface.dll` now say what Meta's `FacebookImporter` sets, because that importer does nothing to files in a package."
      ]
    }
  ]
}
